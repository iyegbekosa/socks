#!/usr/bin/env bash
# Run a command with the locally installed Pango on the library path (macOS only).
# Usage: scripts/with-pango .venv/bin/pytest tests/core/test_pdf.py
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$(uname -s)" = "Darwin" ]; then
  if [ ! -d "$REPO/.devlibs/pango/lib" ]; then
    echo "run scripts/dev_pango.sh first" >&2
    exit 1
  fi
  export DYLD_FALLBACK_LIBRARY_PATH="$REPO/.devlibs/pango/lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
fi

exec "$@"
